# P1 calibrated rendering parameters, separate from the original XLSX specifications.
function(tenhou_generate_text_render_profile input output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" profile)
    tenhou_text_get(version "${profile}" NUMBER schema_version)
    tenhou_text_string(status "${profile}" status)
    if (NOT version EQUAL 1)
        message(FATAL_ERROR "Unsupported text rendering profile")
    endif ()
    if (NOT status MATCHES "^(pending_human_calibration|human_confirmed)$")
        message(FATAL_ERROR "Invalid text rendering calibration status")
    endif ()
    set(fields outline_width_pt synthetic_bold_width_pt shadow_offset_x_pt shadow_offset_y_pt
        shadow_blur_pt shadow_alpha info_background_alpha info_padding_x_pt info_padding_y_pt
        info_rule_height_pt chi_secondary_gap_pt chi_secondary_drop_pt)
    set(members "")
    foreach(field IN LISTS fields)
        tenhou_text_get(value "${profile}" NUMBER ${field})
        set(minimum 0)
        if (field MATCHES "^(shadow_offset_[xy]_pt|chi_secondary_(gap|drop)_pt)$")
            set(minimum -64)
        endif ()
        if (value LESS minimum OR value GREATER 64)
            message(FATAL_ERROR "Invalid text rendering parameter ${field}")
        endif ()
        if (field MATCHES "alpha$" AND value GREATER 1)
            message(FATAL_ERROR "Invalid text rendering alpha ${field}")
        endif ()
        if (field STREQUAL "info_rule_height_pt" AND NOT value GREATER 0)
            message(FATAL_ERROR "Info gradient rows must have positive height")
        endif ()
        string(APPEND members "    double ${field} = ${value};\n")
    endforeach()
    tenhou_text_get(highlight "${profile}" ARRAY info_highlight_alpha)
    string(JSON highlight_count LENGTH "${highlight}")
    if (highlight_count LESS 2 OR highlight_count GREATER 32)
        message(FATAL_ERROR "Invalid Info highlight alpha curve")
    endif ()
    math(EXPR highlight_last "${highlight_count} - 1")
    set(previous_position -1)
    set(highlight_entries "")
    foreach(i RANGE ${highlight_last})
        tenhou_text_get(position "${highlight}" NUMBER ${i} 0)
        tenhou_text_get(alpha "${highlight}" NUMBER ${i} 1)
        if (position LESS 0 OR position GREATER 1 OR NOT position GREATER previous_position OR
                alpha LESS 0 OR alpha GREATER 1)
            message(FATAL_ERROR "Invalid Info highlight alpha stop")
        endif ()
        if ((i EQUAL 0 AND NOT position EQUAL 0) OR (i EQUAL highlight_last AND NOT position EQUAL 1))
            message(FATAL_ERROR "Info highlight curve must cover 0..1")
        endif ()
        string(APPEND highlight_entries "    {${position}, ${alpha}},\n")
        set(previous_position "${position}")
    endforeach()
    file(SHA256 "${input}" profile_hash)
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/assets/text/catalog.json" catalog_hash)
    set(header "// Generated from assets/text/rendering.json. Do not edit.\n#pragma once\nnamespace tenhou {\nstruct TextRenderProfile {\n${members}};\nstruct TextAlphaStop { double position, alpha; };\ninline constexpr TextAlphaStop kInfoHighlightAlpha[]{\n${highlight_entries}};\ninline constexpr const char *kTextRenderProfileStatus = \"${status}\";\ninline constexpr const char *kTextRenderProfileSha256 = \"${profile_hash}\";\ninline constexpr const char *kTextRenderCatalogSha256 = \"${catalog_hash}\";\n}\n")
    file(WRITE "${output}.in" "${header}")
    configure_file("${output}.in" "${output}" COPYONLY)
endfunction()
