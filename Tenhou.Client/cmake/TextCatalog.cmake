# Registered JSON only: normal configure/build never reads Excel or runs Python.
function(tenhou_text_get output json type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if (error OR NOT actual_type STREQUAL type)
        message(FATAL_ERROR "Text catalog: expected ${type} at ${ARGN}: ${error}")
    endif ()
    string(JSON value GET "${json}" ${ARGN})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_string output json)
    tenhou_text_get(value "${json}" STRING ${ARGN})
    if (value STREQUAL "")
        message(FATAL_ERROR "Text catalog: empty string at ${ARGN}")
    endif ()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_symbol output value)
    if (NOT value MATCHES "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$")
        message(FATAL_ERROR "Text catalog: invalid semantic key ${value}")
    endif ()
    string(REPLACE "." "_" symbol "${value}")
    set(${output} "${symbol}" PARENT_SCOPE)
endfunction()

function(tenhou_text_quote output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(tenhou_text_bool output json)
    tenhou_text_get(value "${json}" BOOLEAN ${ARGN})
    if (value)
        set(${output} true PARENT_SCOPE)
    else ()
        set(${output} false PARENT_SCOPE)
    endif ()
endfunction()

function(tenhou_generate_text_catalog input output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" json)
    tenhou_text_get(version "${json}" NUMBER schema_version)
    if (NOT version EQUAL 1)
        message(FATAL_ERROR "Text catalog: unsupported schema version ${version}")
    endif ()
    foreach(field sha256 worksheet_sha256)
        tenhou_text_string(hash "${json}" source ${field})
        string(LENGTH "${hash}" hash_length)
        if (NOT hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 64)
            message(FATAL_ERROR "Text catalog: invalid source ${field}")
        endif ()
    endforeach()
    set(label_keys "")
    set(label_symbols "")
    set(label_enum "")
    set(label_entries "")
    tenhou_text_get(labels "${json}" ARRAY labels)
    string(JSON count LENGTH "${labels}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: empty label pool")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON record GET "${labels}" ${i})
        tenhou_text_string(key "${record}" key)
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST label_symbols)
            message(FATAL_ERROR "Text catalog: duplicate label key ${key}")
        endif ()
        tenhou_text_string(label "${record}" label)
        tenhou_text_quote(label_literal "${label}")
        list(APPEND label_keys "${key}")
        list(APPEND label_symbols "${symbol}")
        set(label_value_${key} "${label}")
        set(label_symbol_${key} "${symbol}")
        string(APPEND label_enum "    ${symbol},\n")
        string(APPEND label_entries "    {TextLabelKey::${symbol}, L${label_literal}, ${label_literal}},\n")
    endforeach()
    tenhou_text_string(source_sha "${json}" source sha256)
    tenhou_text_string(worksheet "${json}" source worksheet)
    tenhou_text_quote(worksheet_literal "${worksheet}")
    set(categories Center Self Option Yaku Button Title Nagashi Caption Info Normal)
    set(palette_keys "")
    set(palette_symbols "")
    set(color_enum "")
    set(color_entries "")
    tenhou_text_get(palette "${json}" ARRAY palette)
    string(JSON count LENGTH "${palette}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: empty palette")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON color GET "${palette}" ${i})
        tenhou_text_string(key "${color}" key)
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST palette_symbols)
            message(FATAL_ERROR "Text catalog: duplicate palette key ${key}")
        endif ()
        list(APPEND palette_keys "${key}")
        list(APPEND palette_symbols "${symbol}")
        string(APPEND color_enum "    ${symbol},\n")
        tenhou_text_get(rgba "${color}" ARRAY rgba)
        string(JSON channels LENGTH "${rgba}")
        if (NOT channels EQUAL 4)
            message(FATAL_ERROR "Text catalog: RGBA requires four channels")
        endif ()
        set(values "")
        foreach(channel RANGE 0 3)
            tenhou_text_get(value "${rgba}" NUMBER ${channel})
            if (NOT value MATCHES "^[0-9]+$" OR value GREATER 255)
                message(FATAL_ERROR "Text catalog: invalid RGBA channel")
            endif ()
            string(APPEND values "${value}, ")
        endforeach()
        tenhou_text_bool(calibrated "${color}" calibrated)
        string(APPEND color_entries "    {TextColor::${symbol}, {${values}}, ${calibrated}},\n")
    endforeach()
    set(style_keys "")
    set(style_symbols "")
    set(style_enum "")
    set(style_entries "")
    tenhou_text_get(styles "${json}" ARRAY styles)
    string(JSON count LENGTH "${styles}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: no styles")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON style GET "${styles}" ${i})
        tenhou_text_string(key "${style}" key)
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST style_symbols)
            message(FATAL_ERROR "Text catalog: duplicate style key ${key}")
        endif ()
        list(APPEND style_keys "${key}")
        list(APPEND style_symbols "${symbol}")
        string(APPEND style_enum "    ${symbol},\n")
        tenhou_text_string(category "${style}" category)
        tenhou_text_string(font "${style}" font)
        tenhou_text_quote(font_literal "${font}")
        tenhou_text_get(size "${style}" NUMBER size_pt)
        tenhou_text_get(spacing "${style}" NUMBER spacing_pt)
        if (NOT category IN_LIST categories OR size LESS_EQUAL 0)
            message(FATAL_ERROR "Text catalog: invalid category/size in ${key}")
        endif ()
        set(style_category_${symbol} "${category}")
        set(style_size_${symbol} "${size}")
        tenhou_text_bool(bold "${style}" bold)
        tenhou_text_bool(shadow "${style}" shadow)
        foreach(field fill outline)
            tenhou_text_string(${field} "${style}" ${field})
            if (NOT ${field} IN_LIST palette_keys)
                message(FATAL_ERROR "Text catalog: unknown ${field} color in ${key}")
            endif ()
        endforeach()
        tenhou_text_string(alignment "${style}" alignment)
        tenhou_text_string(decoration "${style}" decoration)
        if (NOT alignment MATCHES "^(left|center|right)$" OR NOT decoration MATCHES "^(none|info_gradient)$")
            message(FATAL_ERROR "Text catalog: invalid alignment/decoration in ${key}")
        endif ()
        string(APPEND style_entries "    {TextStyleKey::${symbol}, L${font_literal}, ${size}, ${spacing}, ${bold}, TextColor::${fill}, TextColor::${outline}, ${shadow}, TextAlignment::${alignment}, TextDecoration::${decoration}},\n")
    endforeach()
    set(text_enum "")
    set(text_entries "")
    set(image_enum "")
    set(image_entries "")
    set(origin_ids "")
    set(text_keys "")
    set(all_symbols "")
    set(info_count 0)
    foreach(kind texts images)
        tenhou_text_get(records "${json}" ARRAY ${kind})
        string(JSON count LENGTH "${records}")
        if ((kind STREQUAL texts AND NOT count EQUAL 296) OR (kind STREQUAL images AND NOT count EQUAL 7))
            message(FATAL_ERROR "Text catalog: expected 296 Text / 7 Image")
        endif ()
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON record GET "${records}" ${i})
            tenhou_text_string(key "${record}" key)
            tenhou_text_symbol(symbol "${key}")
            tenhou_text_get(origin "${record}" NUMBER origin_id)
            if (symbol IN_LIST all_symbols OR origin IN_LIST origin_ids)
                message(FATAL_ERROR "Text catalog: duplicate key or OriginId ${key}/${origin}")
            endif ()
            if (NOT origin MATCHES "^[0-9]+$" OR origin LESS 401 OR origin GREATER 705 OR origin EQUAL 434 OR origin EQUAL 593)
                message(FATAL_ERROR "Text catalog: unexpected OriginId ${origin}")
            endif ()
            list(APPEND all_symbols "${symbol}")
            list(APPEND origin_ids "${origin}")
            tenhou_text_string(source_type "${record}" source type)
            if (kind STREQUAL images)
                if (NOT origin MATCHES "^(401|402|440|466|589|591|592)$" OR NOT source_type STREQUAL Image)
                    message(FATAL_ERROR "Text catalog: invalid Image ${origin}")
                endif ()
                foreach(field label label_key style composition)
                    string(JSON field_type ERROR_VARIABLE error TYPE "${record}" ${field})
                    if (NOT error)
                        message(FATAL_ERROR "Text catalog: Image ${origin} contains text field ${field}")
                    endif ()
                endforeach()
                string(APPEND image_enum "    ${symbol},\n")
                string(APPEND image_entries "    {TextImageKey::${symbol}, ${origin}},\n")
                continue()
            endif ()
            if (origin MATCHES "^(401|402|440|466|589|591|592)$" OR NOT source_type STREQUAL Text)
                message(FATAL_ERROR "Text catalog: Image mixed into Text ${origin}")
            endif ()
            list(APPEND text_keys "${key}")
            set(text_symbol_${key} "${symbol}")
            tenhou_text_string(label_key "${record}" label_key)
            if (NOT label_key IN_LIST label_keys)
                message(FATAL_ERROR "Text catalog: unknown label key at ${origin}")
            endif ()
            set(label "${label_value_${label_key}}")
            tenhou_text_string(source_label "${record}" source label)
            tenhou_text_string(category "${record}" category)
            tenhou_text_string(style "${record}" style)
            if (NOT label STREQUAL source_label OR NOT category IN_LIST categories OR NOT style IN_LIST style_keys)
                message(FATAL_ERROR "Text catalog: label/category/style mismatch at ${origin}")
            endif ()
            tenhou_text_symbol(style_symbol "${style}")
            if (NOT category STREQUAL style_category_${style_symbol})
                message(FATAL_ERROR "Text catalog: style category mismatch at ${origin}")
            endif ()
            tenhou_text_string(composition "${record}" composition)
            if ((origin EQUAL 459 AND NOT composition STREQUAL chi_selection) OR
                (NOT origin EQUAL 459 AND NOT composition STREQUAL plain))
                message(FATAL_ERROR "Text catalog: unexpected composition at ${origin}")
            endif ()
            tenhou_text_get(inherited "${record}" ARRAY inherited_fields)
            string(JSON inherited_count LENGTH "${inherited}")
            string(JSON inherits_type TYPE "${record}" inherits_origin_id)
            if (category STREQUAL Info)
                math(EXPR info_count "${info_count} + 1")
                if (NOT style STREQUAL info OR NOT style_size_${style_symbol} EQUAL 16)
                    message(FATAL_ERROR "Text catalog: Info must use shared 16 pt style")
                endif ()
            endif ()
            if (category STREQUAL Info AND NOT origin EQUAL 566)
                tenhou_text_get(inherits "${record}" NUMBER inherits_origin_id)
                if (NOT inherits EQUAL 566 OR NOT inherited_count EQUAL 3)
                    message(FATAL_ERROR "Text catalog: missing Info inheritance at ${origin}")
                endif ()
                foreach(index RANGE 0 2)
                    tenhou_text_string(field "${inherited}" ${index})
                    if (NOT field MATCHES "^(size|color|style)$" OR field IN_LIST seen_inherited)
                        message(FATAL_ERROR "Text catalog: invalid inherited field at ${origin}")
                    endif ()
                    list(APPEND seen_inherited "${field}")
                    tenhou_text_get(blank "${record}" STRING source ${field})
                    if (NOT blank STREQUAL "")
                        message(FATAL_ERROR "Text catalog: inherited nonblank field at ${origin}")
                    endif ()
                endforeach()
                set(seen_inherited "")
            elseif (NOT inherits_type STREQUAL NULL OR NOT inherited_count EQUAL 0)
                message(FATAL_ERROR "Text catalog: inheritance outside Info at ${origin}")
            endif ()
            if (origin EQUAL 481)
                tenhou_text_get(corrected "${record}" NUMBER overrides size_pt)
                if (NOT corrected EQUAL 24 OR NOT style_size_${style_symbol} EQUAL 24 OR NOT style STREQUAL yaku)
                    message(FATAL_ERROR "Text catalog: 481 must use the ordinary 24 pt yaku style")
                endif ()
            endif ()
            tenhou_text_quote(label_literal "${label}")
            string(APPEND text_enum "    ${symbol},\n")
            string(APPEND text_entries "    {TextKey::${symbol}, ${origin}, TextLabelKey::${label_symbol_${label_key}}, kTextLabels[static_cast<std::size_t>(TextLabelKey::${label_symbol_${label_key}})].label, TextCategory::${category}, TextStyleKey::${style_symbol}, TextComposition::${composition}},\n")
        endforeach()
    endforeach()
    if (NOT info_count EQUAL 25)
        message(FATAL_ERROR "Text catalog: expected 25 Info definitions")
    endif ()
    set(rule_entries "")
    set(rule_keys "")
    tenhou_text_get(patterns "${json}" ARRAY rule_patterns)
    string(JSON count LENGTH "${patterns}")
    if (NOT count EQUAL 101)
        message(FATAL_ERROR "Text catalog: expected 101 variant rule mappings")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON record GET "${patterns}" ${i})
        foreach(field rule server_name text)
            tenhou_text_string(${field} "${record}" ${field})
        endforeach()
        tenhou_text_get(value "${record}" NUMBER default_value)
        if (NOT rule MATCHES "^(guobiao|sichuan)$" OR NOT value MATCHES "^[0-9]+$" OR NOT text IN_LIST text_keys OR "${rule}/${server_name}" IN_LIST rule_keys)
            message(FATAL_ERROR "Text catalog: invalid/duplicate rule mapping ${rule}/${server_name}")
        endif ()
        list(APPEND rule_keys "${rule}/${server_name}")
        tenhou_text_quote(rule_literal "${rule}")
        tenhou_text_quote(name_literal "${server_name}")
        string(APPEND rule_entries "    {${rule_literal}, ${name_literal}, TextKey::${text_symbol_${text}}, ${value}},\n")
    endforeach()
    foreach(gradient body penultimate_row last_row)
        tenhou_text_get(stops "${json}" ARRAY info_decoration ${gradient})
        string(JSON count LENGTH "${stops}")
        if (count LESS 2)
            message(FATAL_ERROR "Text catalog: gradient requires at least two stops")
        endif ()
        math(EXPR last "${count} - 1")
        set(gradient_${gradient} "")
        set(previous_position -1)
        foreach(i RANGE ${last})
            tenhou_text_get(position "${stops}" NUMBER ${i} 0)
            tenhou_text_get(gray "${stops}" NUMBER ${i} 1)
            if (position LESS_EQUAL previous_position OR position GREATER 1 OR position LESS 0 OR
                NOT gray MATCHES "^[0-9]+$" OR gray GREATER 255)
                message(FATAL_ERROR "Text catalog: invalid gradient stop")
            endif ()
            if ((i EQUAL 0 AND NOT position EQUAL 0) OR (i EQUAL last AND NOT position EQUAL 1))
                message(FATAL_ERROR "Text catalog: gradient endpoints must be 0 and 1")
            endif ()
            set(previous_position "${position}")
            string(APPEND gradient_${gradient} "    {${position}, ${gray}},\n")
        endforeach()
    endforeach()
    tenhou_text_get(info_width "${json}" NUMBER info_decoration width_base_advances)
    tenhou_text_get(info_reference "${json}" NUMBER info_decoration reference_origin_id)
    tenhou_text_string(chi_main "${json}" compositions chi_selection main)
    tenhou_text_string(chi_secondary "${json}" compositions chi_selection secondary)
    tenhou_text_quote(chi_main_literal "${chi_main}")
    tenhou_text_quote(chi_secondary_literal "${chi_secondary}")
    # Unknown P1 calibration values are explicit optionals, never guessed zeroes.
    foreach(field alpha padding_pt)
        tenhou_text_get(unresolved "${json}" NULL info_decoration ${field})
    endforeach()
    tenhou_text_get(chi_secondary_size "${json}" NUMBER compositions chi_selection secondary_size_pt)
    if (NOT chi_secondary_size EQUAL 12)
        message(FATAL_ERROR "Text catalog: chi selection secondary text must be 12 pt")
    endif ()
    tenhou_text_get(unresolved "${json}" NULL compositions chi_selection offset_pt)
    get_filename_component(output_directory "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/text_catalog.hpp.in" "${output}" @ONLY)
endfunction()
