# Registered JSON only: normal configure/build never reads Excel or runs Python.
function(tenhou_text_get output json type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if (error OR NOT actual_type STREQUAL type)
        message(FATAL_ERROR "Text catalog: expected ${type} at ${ARGN}: ${error}")
    endif ()
    string(JSON value GET "${json}" ${ARGN})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_string output json)
    tenhou_text_get(value "${json}" STRING ${ARGN})
    if (value STREQUAL "")
        message(FATAL_ERROR "Text catalog: empty string at ${ARGN}")
    endif ()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_optional_string output json default_value)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if (error)
        set(${output} "${default_value}" PARENT_SCOPE)
        return()
    endif ()
    if (NOT actual_type STREQUAL STRING)
        message(FATAL_ERROR "Text catalog: expected STRING at ${ARGN}")
    endif ()
    string(JSON value GET "${json}" ${ARGN})
    if (value STREQUAL "")
        message(FATAL_ERROR "Text catalog: empty string at ${ARGN}")
    endif ()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_optional_number output json default_value)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if (error)
        set(${output} "${default_value}" PARENT_SCOPE)
        return()
    endif ()
    if (NOT actual_type STREQUAL NUMBER)
        message(FATAL_ERROR "Text catalog: expected NUMBER at ${ARGN}")
    endif ()
    string(JSON value GET "${json}" ${ARGN})
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(tenhou_text_optional_bool output json default_value)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if (error)
        set(${output} "${default_value}" PARENT_SCOPE)
        return()
    endif ()
    if (NOT actual_type STREQUAL BOOLEAN)
        message(FATAL_ERROR "Text catalog: expected BOOLEAN at ${ARGN}")
    endif ()
    string(JSON value GET "${json}" ${ARGN})
    if (value)
        set(${output} true PARENT_SCOPE)
    else ()
        set(${output} false PARENT_SCOPE)
    endif ()
endfunction()

function(tenhou_text_symbol output value)
    if (NOT value MATCHES "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$")
        message(FATAL_ERROR "Text catalog: invalid semantic key ${value}")
    endif ()
    string(REPLACE "." "_" symbol "${value}")
    set(${output} "${symbol}" PARENT_SCOPE)
endfunction()

function(tenhou_text_quote output value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(tenhou_generate_text_catalog input output)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" json)
    tenhou_text_get(version "${json}" NUMBER schema_version)
    if (NOT version EQUAL 2)
        message(FATAL_ERROR "Text catalog: unsupported schema version ${version}")
    endif ()
    tenhou_text_string(default_font "${json}" default_font)

    set(label_keys "")
    set(label_symbols "")
    set(label_enum "")
    set(label_entries "")
    tenhou_text_get(labels "${json}" OBJECT labels)
    string(JSON count LENGTH "${labels}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: empty label pool")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${labels}" ${i})
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST label_symbols)
            message(FATAL_ERROR "Text catalog: duplicate label key ${key}")
        endif ()
        tenhou_text_string(label "${labels}" "${key}")
        tenhou_text_quote(label_literal "${label}")
        list(APPEND label_keys "${key}")
        list(APPEND label_symbols "${symbol}")
        set(label_symbol_${key} "${symbol}")
        string(APPEND label_enum "    ${symbol},\n")
        string(APPEND label_entries "    {TextLabelKey::${symbol}, ${label_literal}},\n")
    endforeach()

    set(categories Center Self Option Yaku Button Title Nagashi Caption Info Normal)
    set(palette_keys "")
    set(palette_symbols "")
    set(color_enum "")
    set(color_entries "")
    tenhou_text_get(palette "${json}" OBJECT palette)
    string(JSON count LENGTH "${palette}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: empty palette")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${palette}" ${i})
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST palette_symbols)
            message(FATAL_ERROR "Text catalog: duplicate palette key ${key}")
        endif ()
        list(APPEND palette_keys "${key}")
        list(APPEND palette_symbols "${symbol}")
        string(APPEND color_enum "    ${symbol},\n")
        tenhou_text_get(rgba "${palette}" ARRAY "${key}")
        string(JSON channels LENGTH "${rgba}")
        if (NOT channels EQUAL 4)
            message(FATAL_ERROR "Text catalog: RGBA requires four channels")
        endif ()
        set(channel_values "")
        foreach(channel RANGE 0 3)
            tenhou_text_get(value "${rgba}" NUMBER ${channel})
            if (NOT value MATCHES "^[0-9]+$" OR value GREATER 255)
                message(FATAL_ERROR "Text catalog: invalid RGBA channel")
            endif ()
            list(APPEND channel_values "${value}")
        endforeach()
        list(JOIN channel_values ", " values)
        string(APPEND color_entries "    {TextColor::${symbol}, {${values}}},\n")
    endforeach()

    set(style_keys "")
    set(style_symbols "")
    set(style_enum "")
    set(style_entries "")
    tenhou_text_get(styles "${json}" OBJECT styles)
    string(JSON count LENGTH "${styles}")
    if (count LESS 1)
        message(FATAL_ERROR "Text catalog: no styles")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${styles}" ${i})
        tenhou_text_symbol(symbol "${key}")
        if (symbol IN_LIST style_symbols)
            message(FATAL_ERROR "Text catalog: duplicate style key ${key}")
        endif ()
        list(APPEND style_keys "${key}")
        list(APPEND style_symbols "${symbol}")
        string(APPEND style_enum "    ${symbol},\n")
        tenhou_text_get(style "${styles}" OBJECT "${key}")
        tenhou_text_string(category "${style}" category)
        tenhou_text_optional_string(font "${style}" "${default_font}" font)
        tenhou_text_quote(font_literal "${font}")
        tenhou_text_get(size "${style}" NUMBER size)
        tenhou_text_optional_number(spacing "${style}" 0 spacing)
        if (NOT category IN_LIST categories OR size LESS_EQUAL 0)
            message(FATAL_ERROR "Text catalog: invalid category/size in ${key}")
        endif ()
        set(style_category_${symbol} "${category}")
        set(style_size_${symbol} "${size}")
        tenhou_text_optional_bool(bold "${style}" false bold)
        tenhou_text_optional_bool(shadow "${style}" false shadow)
        tenhou_text_string(fill "${style}" fill)
        tenhou_text_optional_string(outline "${style}" "none" outline)
        foreach(field fill outline)
            if (NOT ${field} IN_LIST palette_keys)
                message(FATAL_ERROR "Text catalog: unknown ${field} color in ${key}")
            endif ()
        endforeach()
        tenhou_text_optional_string(alignment "${style}" "center" alignment)
        tenhou_text_optional_string(decoration "${style}" "none" decoration)
        if (NOT alignment MATCHES "^(left|center|right)$" OR NOT decoration MATCHES "^(none|info_gradient)$")
            message(FATAL_ERROR "Text catalog: invalid alignment/decoration in ${key}")
        endif ()
        string(APPEND style_entries "    {TextStyleKey::${symbol}, ${font_literal}, ${size}, ${spacing}, ${bold}, TextColor::${fill}, TextColor::${outline}, ${shadow}, TextAlignment::${alignment}, TextDecoration::${decoration}},\n")
    endforeach()

    set(image_enum "")
    set(image_entries "")
    set(origin_ids "")
    set(all_symbols "")
    tenhou_text_get(images "${json}" ARRAY images)
    string(JSON count LENGTH "${images}")
    if (NOT count EQUAL 7)
        message(FATAL_ERROR "Text catalog: expected 7 Image definitions")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        tenhou_text_get(origin "${images}" NUMBER ${i})
        if (NOT origin MATCHES "^(401|402|440|466|589|591|592)$" OR origin IN_LIST origin_ids)
            message(FATAL_ERROR "Text catalog: invalid or duplicate Image ${origin}")
        endif ()
        set(symbol "legacy_image_${origin}")
        list(APPEND all_symbols "${symbol}")
        list(APPEND origin_ids "${origin}")
        string(APPEND image_enum "    ${symbol},\n")
        string(APPEND image_entries "    {TextImageKey::${symbol}, ${origin}},\n")
    endforeach()

    set(text_enum "")
    set(text_entries "")
    set(text_keys "")
    set(text_order "")
    set(info_count 0)
    tenhou_text_get(texts "${json}" OBJECT texts)
    string(JSON count LENGTH "${texts}")
    if (NOT count EQUAL 296)
        message(FATAL_ERROR "Text catalog: expected 296 Text definitions")
    endif ()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON key MEMBER "${texts}" ${i})
        tenhou_text_symbol(symbol "${key}")
        tenhou_text_get(record "${texts}" OBJECT "${key}")
        tenhou_text_get(origin "${record}" NUMBER id)
        if (symbol IN_LIST all_symbols OR origin IN_LIST origin_ids)
            message(FATAL_ERROR "Text catalog: duplicate key or OriginId ${key}/${origin}")
        endif ()
        if (NOT origin MATCHES "^[0-9]+$" OR origin LESS 401 OR origin GREATER 705 OR
            origin EQUAL 434 OR origin EQUAL 593 OR origin MATCHES "^(401|402|440|466|589|591|592)$")
            message(FATAL_ERROR "Text catalog: unexpected OriginId ${origin}")
        endif ()
        list(APPEND all_symbols "${symbol}")
        list(APPEND origin_ids "${origin}")
        list(APPEND text_keys "${key}")
        set(text_symbol_${key} "${symbol}")

        tenhou_text_optional_string(label_key "${record}" "${key}" label)
        if (NOT label_key IN_LIST label_keys)
            message(FATAL_ERROR "Text catalog: unknown label key ${label_key} at ${origin}")
        endif ()
        tenhou_text_string(style "${record}" style)
        if (NOT style IN_LIST style_keys)
            message(FATAL_ERROR "Text catalog: unknown style ${style} at ${origin}")
        endif ()
        tenhou_text_symbol(style_symbol "${style}")
        set(category "${style_category_${style_symbol}}")
        tenhou_text_optional_string(composition "${record}" "plain" composition)
        if ((origin EQUAL 459 AND NOT composition STREQUAL chi_selection) OR
            (NOT origin EQUAL 459 AND NOT composition STREQUAL plain))
            message(FATAL_ERROR "Text catalog: unexpected composition at ${origin}")
        endif ()
        if (category STREQUAL Info)
            math(EXPR info_count "${info_count} + 1")
            if (NOT style STREQUAL info OR NOT style_size_${style_symbol} EQUAL 16)
                message(FATAL_ERROR "Text catalog: Info must use shared 16 pt style")
            endif ()
        endif ()
        if (origin EQUAL 481 AND (NOT style STREQUAL yaku OR NOT style_size_${style_symbol} EQUAL 24))
            message(FATAL_ERROR "Text catalog: 481 must use the ordinary 24 pt yaku style")
        endif ()

        set(text_entry_${symbol} "    {TextKey::${symbol}, ${origin}, TextLabelKey::${label_symbol_${label_key}}, kTextLabels[static_cast<std::size_t>(TextLabelKey::${label_symbol_${label_key}})].label, TextCategory::${category}, TextStyleKey::${style_symbol}, TextComposition::${composition}},\n")
        if (origin LESS 1000)
            set(padded_id "0${origin}")
        else ()
            set(padded_id "${origin}")
        endif ()
        list(APPEND text_order "${padded_id}|${symbol}")
    endforeach()
    if (NOT info_count EQUAL 25)
        message(FATAL_ERROR "Text catalog: expected 25 Info definitions")
    endif ()
    list(SORT text_order)
    foreach(item IN LISTS text_order)
        string(REGEX REPLACE "^[0-9]+\\|" "" symbol "${item}")
        string(APPEND text_enum "    ${symbol},\n")
        string(APPEND text_entries "${text_entry_${symbol}}")
    endforeach()

    set(rule_entries "")
    set(rule_count 0)
    tenhou_text_get(patterns "${json}" OBJECT rule_patterns)
    string(JSON group_count LENGTH "${patterns}")
    if (group_count LESS 1)
        message(FATAL_ERROR "Text catalog: empty rule_patterns")
    endif ()
    math(EXPR group_last "${group_count} - 1")
    foreach(g RANGE ${group_last})
        string(JSON rule MEMBER "${patterns}" ${g})
        if (NOT rule MATCHES "^(guobiao|sichuan)$")
            message(FATAL_ERROR "Text catalog: unsupported rule family ${rule}")
        endif ()
        tenhou_text_quote(rule_literal "${rule}")
        tenhou_text_get(rule_map "${patterns}" OBJECT "${rule}")
        string(JSON count LENGTH "${rule_map}")
        if (count LESS 1)
            message(FATAL_ERROR "Text catalog: empty rule_patterns.${rule}")
        endif ()
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON server_name MEMBER "${rule_map}" ${i})
            if (server_name STREQUAL "")
                message(FATAL_ERROR "Text catalog: empty server_name in ${rule}")
            endif ()
            tenhou_text_get(pair "${rule_map}" ARRAY "${server_name}")
            string(JSON pair_len LENGTH "${pair}")
            if (NOT pair_len EQUAL 2)
                message(FATAL_ERROR "Text catalog: rule mapping must be [text_key, default_value] for ${rule}/${server_name}")
            endif ()
            tenhou_text_string(text "${pair}" 0)
            tenhou_text_get(value "${pair}" NUMBER 1)
            if (NOT value MATCHES "^[0-9]+$" OR NOT text IN_LIST text_keys)
                message(FATAL_ERROR "Text catalog: invalid rule mapping ${rule}/${server_name}")
            endif ()
            tenhou_text_quote(name_literal "${server_name}")
            string(APPEND rule_entries "    {${rule_literal}, ${name_literal}, TextKey::${text_symbol_${text}}, ${value}},\n")
            math(EXPR rule_count "${rule_count} + 1")
        endforeach()
    endforeach()
    if (NOT rule_count EQUAL 101)
        message(FATAL_ERROR "Text catalog: expected 101 variant rule mappings")
    endif ()

    foreach(gradient body penultimate_row last_row)
        tenhou_text_get(stops "${json}" ARRAY info_decoration ${gradient})
        string(JSON count LENGTH "${stops}")
        if (count LESS 2)
            message(FATAL_ERROR "Text catalog: gradient requires at least two stops")
        endif ()
        math(EXPR last "${count} - 1")
        set(gradient_${gradient} "")
        set(previous_position -1)
        foreach(i RANGE ${last})
            tenhou_text_get(position "${stops}" NUMBER ${i} 0)
            tenhou_text_get(gray "${stops}" NUMBER ${i} 1)
            if (position LESS_EQUAL previous_position OR position GREATER 1 OR position LESS 0 OR
                NOT gray MATCHES "^[0-9]+$" OR gray GREATER 255)
                message(FATAL_ERROR "Text catalog: invalid gradient stop")
            endif ()
            if ((i EQUAL 0 AND NOT position EQUAL 0) OR (i EQUAL last AND NOT position EQUAL 1))
                message(FATAL_ERROR "Text catalog: gradient endpoints must be 0 and 1")
            endif ()
            set(previous_position "${position}")
            string(APPEND gradient_${gradient} "    {${position}, ${gray}},\n")
        endforeach()
    endforeach()
    tenhou_text_get(info_width "${json}" NUMBER info_decoration width_base_advances)
    if (info_width LESS_EQUAL 0)
        message(FATAL_ERROR "Text catalog: info width_base_advances must be positive")
    endif ()
    tenhou_text_string(chi_main "${json}" compositions chi_selection main)
    tenhou_text_string(chi_secondary "${json}" compositions chi_selection secondary)
    tenhou_text_quote(chi_main_literal "${chi_main}")
    tenhou_text_quote(chi_secondary_literal "${chi_secondary}")
    tenhou_text_get(chi_secondary_size "${json}" NUMBER compositions chi_selection secondary_size_pt)
    if (NOT chi_secondary_size EQUAL 12)
        message(FATAL_ERROR "Text catalog: chi selection secondary text must be 12 pt")
    endif ()

    get_filename_component(output_directory "${output}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/text_catalog.hpp.in" "${output}" @ONLY)
endfunction()
