# Pure CMake generator: converts EMBEDDED catalog assets into portable C++ static byte arrays,
# replacing Win32 RCDATA (FindResourceW/LoadResource/LockResource).
cmake_minimum_required(VERSION 3.24)

if(NOT DEFINED OUTPUT_CPP OR NOT DEFINED MANIFEST_FILE)
    message(FATAL_ERROR "EmbedAssets.cmake requires OUTPUT_CPP and MANIFEST_FILE")
endif()

file(STRINGS "${MANIFEST_FILE}" entries ENCODING UTF-8)

set(cpp_body "// Generated by cmake/EmbedAssets.cmake. Do not edit.\n")
string(APPEND cpp_body "#include \"embedded_assets.hpp\"\n\n")
string(APPEND cpp_body "namespace tenhou {\nnamespace {\n")

set(lookup_cases "")
foreach(entry IN LISTS entries)
    if("${entry}" STREQUAL "")
        continue()
    endif()
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 asset_key)
    list(GET parts 1 asset_path)
    file(SIZE "${asset_path}" asset_size)
    file(READ "${asset_path}" hex_data HEX)
    # Chunk into 32-char (16-byte) lines using hex escapes inside a string literal?
    # Wait: MSVC has a 64KB limit on single string literals, whereas uint8_t array initializers
    # have no such limit and compile cleanly under /W4 /WX.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," byte_list "${hex_data}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " byte_list "${byte_list}")
    string(APPEND cpp_body "alignas(16) constexpr std::uint8_t kData_${asset_key}[${asset_size}] = {\n    ${byte_list}\n};\n\n")
    string(APPEND lookup_cases "        case AssetId::${asset_key}: return {kData_${asset_key}, sizeof(kData_${asset_key})};\n")
endforeach()

string(APPEND cpp_body "} // namespace\n\n")
string(APPEND cpp_body "EmbeddedAsset FindEmbeddedAsset(AssetId id) {\n")
string(APPEND cpp_body "    switch (id) {\n")
string(APPEND cpp_body "${lookup_cases}")
string(APPEND cpp_body "        default: return {nullptr, 0};\n")
string(APPEND cpp_body "    }\n")
string(APPEND cpp_body "}\n")
string(APPEND cpp_body "} // namespace tenhou\n")

file(WRITE "${OUTPUT_CPP}" "${cpp_body}")
