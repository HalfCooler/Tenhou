<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>bin\$(Configuration)\</OutDir>
    <IntDir>obj\vs\$(Configuration)\</IntDir>
    <RestoreProjectStyle>Unknown</RestoreProjectStyle>
    <NMakeIncludeSearchPath>$(MSBuildThisFileDirectory)..\Tenhou.Client\src;$(MSBuildThisFileDirectory)..\Tenhou.Client\vendor\zlib;$(MSBuildThisFileDirectory)..\Tenhou.Client\vendor\miniaudio;$(MSBuildProjectDirectory)\obj\native\$(Configuration)\generated;$(NMakeIncludeSearchPath)</NMakeIncludeSearchPath>
    <NMakePreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_UTF8_SOURCE;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
    <AdditionalOptions>/std:c++17 /utf-8 $(AdditionalOptions)</AdditionalOptions>
    <TenhouBuildCommand>powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\Build-Tenhou.ps1&quot; -Target $(MSBuildProjectName)</TenhouBuildCommand>
    <NMakeBuildCommandLine>$(TenhouBuildCommand) -Configuration $(Configuration)</NMakeBuildCommandLine>
    <NMakeCleanCommandLine>$(TenhouBuildCommand) -Clean</NMakeCleanCommandLine>
  </PropertyGroup>

  <!-- dotnet MSBuild runs the same commands without loading the desktop C++ targets. -->
  <Import Project="$(MSBuildToolsPath)\NuGet.targets" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <Target Name="Build" Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <Exec Command="$(NMakeBuildCommandLine)" />
  </Target>
  <Target Name="Clean" Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <Exec Command="$(NMakeCleanCommandLine)" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" Condition="'$(MSBuildRuntimeType)' == 'Core'" />
</Project>
