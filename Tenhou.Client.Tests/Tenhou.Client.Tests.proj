<Project DefaultTargets="Build">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <RestoreProjectStyle>Unknown</RestoreProjectStyle>
  </PropertyGroup>
  <ItemGroup>
    <None Include="src/**;Tests.cmake;Build-Tenhou.Client.Tests.ps1;../scripts/Build.Common.ps1" />
    <None Include="../docs/Tenhou.Client.Tests/**" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/NuGet.targets" Condition="Exists('$(MSBuildToolsPath)/NuGet.targets')" />
  <Target Name="Build">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../Build-Tenhou.ps1&quot; -Target Tenhou.Client.Tests -Configuration $(Configuration)" />
  </Target>
  <Target Name="Clean">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)../Build-Tenhou.ps1&quot; -Target Tenhou.Client.Tests -Clean" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
